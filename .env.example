# Discord Settings
DISCORD_TOKEN=
# カンマ区切りで自動反応するテキストチャンネルID・フォーラムチャンネルIDを指定
DISCORD_CHANNEL_IDS=

# Ollama Connection
OLLAMA_BASE_URL=http://localip:11434
LLM_TIMEOUT=2400
# Thinking Mode: true / false / high / medium / low / max
OLLAMA_THINK=high
# プロンプト側からも最高レベルの思考を強制するかのフラグ (True / False)
THINK_PROMPT_BOOST=True
# モデルをメモリ(VRAM/RAM)に常駐させる時間 (例: 24h, -1 で無期限常駐)
OLLAMA_KEEP_ALIVE=24h
# Ollama Generation & Hardware Options (必要なものだけ記述、空欄はデフォルト)
SERVER_CTX_SIZE=8192
MAX_TOKEN=4096
LLM_TEMP=
LLM_TOP_P=
LLM_TOP_K=
LLM_MIN_P=
LLM_REPEAT_PENALTY=
LLM_REPEAT_LAST_N=
LLM_PRESENCE_PENALTY=
LLM_FREQ_PENALTY=
LLM_SEED=
OLLAMA_NUM_GPU=
OLLAMA_NUM_THREAD=
OLLAMA_NUM_BATCH=

# SIer Role Models (未指定時は MODEL_MAIN にフォールバック)
MODEL_MAIN=
MODEL_PM=
MODEL_SE=
MODEL_PG=
MODEL_QA=
MODEL_AUDITOR=

# Sandbox & Directories
DOCKER_IMAGE=python:3.12-slim
DOCKER_MEM_LIMIT=4g
COMMAND_TIMEOUT=300
WORKSPACE_DIR=./workspace
EXPORTS_DIR=./exports
LOG_DIR=./logs

# Loop Intervals & Limits
MAX_STEPS_PER_PHASE=20
PIPELINE_IDLE_SEC=10
AUDITOR_INTERVAL_SEC=180

# Status Monitor Box Settings
DISCORD_STATUS_CHANNEL_ID=
STATUS_UPDATE_INTERVAL_SEC=120
DESKTOP_VRAM_GB=8.0
DESKTOP_RAM_GB=8.0

# Raw Log Monitor Box Settings
DISCORD_RAW_LOG_CHANNEL_ID=

# NAS Settings (WebUI + WebDAV + Samba)
NAS_ENABLE=False
NAS_PORT=
NAS_USER=
NAS_PASSWORD=
SAMBA_ENABLE=False
SAMBA_PORT=