# Discord Settings
DISCORD_TOKEN=
# カンマ区切りで自動反応するテキストチャンネルID・フォーラムチャンネルIDを指定
DISCORD_CHANNEL_IDS=

# Ollama Connection
OLLAMA_BASE_URL=http://exampleip:11434
LLM_TIMEOUT=2400

# Thinking Mode: true / false / high / medium / low / max
OLLAMA_THINK=true
# プロンプト側からも最高レベルの思考を強制するかのフラグ (True / False)
THINK_PROMPT_BOOST=False
# 軽量モデルをメモリ(VRAM/RAM)に常駐させる時間 (-1 で無期限常駐)
OLLAMA_KEEP_ALIVE=24h

# Ollama Generation & Hardware Options (Light Models: 必要なものだけ記述、空欄はOllamaデフォルト)
SERVER_CTX_SIZE=16384
MAX_TOKEN=4096
LLM_TEMP=1.0
LLM_TOP_P=0.95
LLM_TOP_K=64
LLM_MIN_P=0.0
LLM_REPEAT_PENALTY=1.0
LLM_REPEAT_LAST_N=64
LLM_PRESENCE_PENALTY=
LLM_FREQ_PENALTY=
LLM_SEED=
OLLAMA_NUM_GPU=
OLLAMA_NUM_THREAD=8
OLLAMA_NUM_BATCH=512

OLLAMA_NUM_PARALLEL=1
STREAM_GRANULARITY_TOKENS=1
IO_CHUNK_BYTES=65536

# Context Character Safety Budgets (Python側のメッセージ・ファイル読み込み文字数上限)
CTX_CHAR_BUDGET_LIGHT=36000
CTX_CHAR_BUDGET_HEAVY=120000

# SIer Role Models (Light / Scout & Operator Models: 未指定時は MODEL_MAIN にフォールバック)
MODEL_MAIN=
MODEL_PM=
MODEL_SE=
MODEL_PG=
MODEL_QA=
MODEL_AUDITOR=

# Heavy Brain Model Settings
MODEL_HEAVY=
MODEL_HEAVY_SE=
MODEL_HEAVY_PG=
HEAVY_CTX_SIZE=65536
HEAVY_MAX_TOKEN=32768
HEAVY_THINK=high
HEAVY_KEEP_ALIVE=0
HEAVY_TEMP=0.7
HEAVY_TOP_P=0.95
HEAVY_TOP_K=64
HEAVY_MIN_P=0.0
HEAVY_REPEAT_PENALTY=1.0
HEAVY_REPEAT_LAST_N=64
HEAVY_PRESENCE_PENALTY=
HEAVY_FREQ_PENALTY=
HEAVY_SEED=
HEAVY_NUM_GPU=
HEAVY_NUM_THREAD=8
HEAVY_NUM_BATCH=512

# Autonomous Idle-Time Initiative Settings
AUTONOMOUS_ENABLE=True
AUTONOMOUS_IDLE_SEC=60
AUTONOMOUS_MAX_STEPS=15

# Sandbox & Directories
DOCKER_IMAGE=sier-sandbox:latest
DOCKER_MEM_LIMIT=4g
COMMAND_TIMEOUT=300
WORKSPACE_DIR=./workspace
EXPORTS_DIR=./exports
LOG_DIR=./logs

# Loop Intervals & Limits
MAX_STEPS_PER_PHASE=120
PIPELINE_IDLE_SEC=10
AUDITOR_INTERVAL_SEC=21600

# Status Monitor Box Settings
DISCORD_STATUS_CHANNEL_ID=
STATUS_UPDATE_INTERVAL_SEC=10
DESKTOP_VRAM_GB=8.0
DESKTOP_RAM_GB=16.0

# Raw Log Monitor Box Settings
DISCORD_RAW_LOG_CHANNEL_ID=

# NAS Settings (WebUI + WebDAV + Samba)
NAS_ENABLE=False
NAS_PORT=8080
NAS_USER=
NAS_PASSWORD=
SAMBA_ENABLE=False
SAMBA_PORT=445

# Ubuntu Server 側で動かす desktop_metrics_server.py のURL (未設定時は /api/ps にフォールバック)
DESKTOP_METRICS_URL=http://exampleip:11435/metrics

# Optional Sandbox Environment Hint (SE/PG/QA に通知するコンテナ内導入済みツールのヒント)
# 例: SANDBOX_ENV_HINT="※ Docker環境には Python3, gcc/g++が導入済みです。\n"
SANDBOX_ENV_HINT=
