# Discord Settings
DISCORD_TOKEN=
# カンマ区切りで自動反応するテキストチャンネルID・フォーラムチャンネルIDを指定
DISCORD_CHANNEL_IDS=

# Ollama Settings
OLLAMA_BASE_URL=http://localip:11434
LLM_TIMEOUT=2400
SERVER_CTX_SIZE=32768
MAX_TOKEN=4096
LLM_TEMP=0.2
LLM_TOP_P=0.9

# SIer Role Models (未指定時は MODEL_MAIN にフォールバック)
# 例: Gemma4:31B
MODEL_MAIN=
MODEL_PM=
MODEL_SE=
MODEL_PG=
MODEL_QA=
MODEL_AUDITOR=

# Sandbox & Directories
DOCKER_IMAGE=python:3.12-slim
DOCKER_MEM_LIMIT=4g
COMMAND_TIMEOUT=300
WORKSPACE_DIR=./workspace
EXPORTS_DIR=./exports
LOG_DIR=./logs

# Loop Intervals & Limits
MAX_STEPS_PER_PHASE=20
PIPELINE_IDLE_SEC=10
AUDITOR_INTERVAL_SEC=180

# Status Monitor Box Settings
DISCORD_STATUS_CHANNEL_ID=
STATUS_UPDATE_INTERVAL_SEC=120
DESKTOP_VRAM_GB=8.0
DESKTOP_RAM_GB=8.0

# Raw Log Monitor Box Settings
DISCORD_RAW_LOG_CHANNEL_ID=

# NAS Settings (WebUI + WebDAV + Samba)
NAS_ENABLE=False
NAS_PORT=
NAS_USER=
NAS_PASSWORD=
SAMBA_ENABLE=False
SAMBA_PORT=