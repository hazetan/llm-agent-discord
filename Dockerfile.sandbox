FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive

# C/C++ ビルドツール、Git、OpenSCAD、MicroPythonビルド依存パッケージを導入
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    build-essential \
    libffi-dev \
    pkg-config \
    ca-certificates \
    curl \
    openscad \
    && rm -rf /var/lib/apt/lists/*

# Python テスト・MicroPython・3Dモデル生成/検証ライブラリを導入
RUN pip install --no-cache-dir \
    pytest \
    mpremote \
    trimesh \
    solidpython2 \
    numpy-stl \
    manifold3d

# MicroPython (Unix ポート版) をソースからビルドして /usr/local/bin/micropython に配置
RUN git clone --depth 1 https://github.com/micropython/micropython.git /tmp/micropython \
    && make -C /tmp/micropython/mpy-cross -j$(nproc) \
    && make -C /tmp/micropython/ports/unix submodules \
    && make -C /tmp/micropython/ports/unix -j$(nproc) \
    && cp /tmp/micropython/ports/unix/build-standard/micropython /usr/local/bin/micropython \
    && rm -rf /tmp/micropython

WORKDIR /root